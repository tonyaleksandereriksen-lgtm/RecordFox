{
  "name": "rekordfox",
  "productName": "RekordFox",
  "version": "0.3.1",
  "private": true,
  "description": "Two-deck DJ performance app for the AlphaTheta DDJ-FLX2 (MIDI).",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node serve.mjs --open",
    "serve": "node serve.mjs",
    "app": "electron .",
    "app:dev": "node scripts/app-dev.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && node scripts/native-tests.mjs",
    "docs:midi": "node scripts/gen-midi-doc.ts",
    "native": "node scripts/build-native.mjs",
    "native:smoke": "electron scripts/native-smoke.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
